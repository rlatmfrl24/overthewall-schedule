# Copy to .env.development.local or .env.production.local in this directory.
# Precedence: explicit OTW_* process inputs > site mode files > site shared files
# > legacy root OTW mode/shared files. Generic process VITE_*/CLERK_* are ignored.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_ADMIN_IDS=
X_BEARER_TOKEN=
X_CLIENT_SECRET=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Optional local overrides shared by dev/restart/stop and D1 tools.
DEV_PORT=5173
D1_PERSIST_TO=.wrangler/state/otw
# Production only; OTW defaults to https://otw-schedule.info.
PUBLIC_ORIGIN=
