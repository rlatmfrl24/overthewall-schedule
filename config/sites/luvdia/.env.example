# Copy to .env.development.local or .env.production.local in this directory.
# Precedence: explicit LUVDIA_* process inputs > site mode files > site shared files.
# Root OTW files and generic process VITE_*/CLERK_* are never used for LuvDia.
# Use a separate Clerk app. Its key's frontend API origin must match CLERK_ISSUER.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_ADMIN_IDS=
CLERK_AUTHORIZED_PARTIES=http://localhost:5174
# Optional local overrides shared by dev/restart/stop and D1 tools.
DEV_PORT=5174
D1_PERSIST_TO=.wrangler/state/luvdia
# Required explicit approved production origin; no domain is assigned yet.
PUBLIC_ORIGIN=
# Put server-only external API inputs in this site directory, never VITE_*.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
X_BEARER_TOKEN=
X_CLIENT_SECRET=
OTW_PLAY_AI_REVIEW_ENABLED=false
