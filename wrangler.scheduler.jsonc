{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otw-ops-scheduler",
  "main": "worker/entrypoints/scheduler.ts",
  "compatibility_date": "2025-11-25",
  "observability": { "enabled": true },
  "vars": {
    "OTW_PLAY_PUBLIC_ORIGIN": "https://otw-schedule.info"
  },
  "d1_databases": [
    {
      "binding": "otw_db",
      "database_name": "otw-db",
      "database_id": "133b980d-1701-427e-93fd-8c9dcca1132e",
      "migrations_dir": "drizzle"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "OTW_X_COLLECTION_QUEUE", "queue": "otw-x-collection" },
      { "binding": "OTW_NAVER_CAFE_QUEUE", "queue": "otw-naver-cafe" },
      { "binding": "OTW_WEBSUB_QUEUE", "queue": "otw-websub" },
      { "binding": "OTW_PLAY_INGESTION_QUEUE", "queue": "otw-play-ingestion" },
      { "binding": "OTW_YOUTUBE_CRITICAL_QUEUE", "queue": "otw-youtube-critical" },
      { "binding": "OTW_SCHEDULE_AUTO_UPDATE_QUEUE", "queue": "otw-schedule-auto-update" },
      { "binding": "OTW_MAINTENANCE_QUEUE", "queue": "otw-maintenance" }
    ],
    "consumers": [
      {
        "queue": "otw-ops-control",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "otw-ops-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "workflows": [
    {
      "binding": "INGESTION_RECOVERY_WORKFLOW",
      "name": "otw-ingestion-recovery",
      "class_name": "IngestionRecoveryWorkflow",
      "schedules": "3 * * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "WEBSUB_MAINTENANCE_WORKFLOW",
      "name": "otw-websub-maintenance",
      "class_name": "WebsubMaintenanceWorkflow",
      "schedules": "13 * * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "CHANNEL_RECONCILE_WORKFLOW",
      "name": "otw-channel-reconcile",
      "class_name": "ChannelReconcileWorkflow",
      "schedules": "23 * * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "SOURCE_HEALTH_WORKFLOW",
      "name": "otw-source-health",
      "class_name": "SourceHealthWorkflow",
      "schedules": "33 * * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "NAVER_CAFE_COLLECTION_WORKFLOW",
      "name": "otw-naver-cafe-collection",
      "class_name": "NaverCafeCollectionWorkflow",
      "schedules": "15 * * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "X_COLLECTION_WORKFLOW",
      "name": "otw-x-collection",
      "class_name": "XCollectionWorkflow",
      "schedules": "25 */2 * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "SCHEDULE_AUTO_UPDATE_WORKFLOW",
      "name": "otw-schedule-auto-update",
      "class_name": "ScheduleAutoUpdateWorkflow",
      "schedules": "5 * * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "RECENT_RECONCILE_WORKFLOW",
      "name": "otw-recent-reconcile",
      "class_name": "RecentReconcileWorkflow",
      "schedules": "20 18 * * *",
      "limits": { "steps": 3 }
    },
    {
      "binding": "RETENTION_PRUNE_WORKFLOW",
      "name": "otw-retention-prune",
      "class_name": "RetentionPruneWorkflow",
      "schedules": "40 18 * * *",
      "limits": { "steps": 3 }
    }
  ],
  "placement": { "mode": "smart" }
}
