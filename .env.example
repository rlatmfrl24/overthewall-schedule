# Shared local-only variables may remain in .env.local, but Clerk client
# variables must be mode-specific so development and production cannot mix.
#
# Local development: create .env.development.local
#   VITE_CLERK_PUBLISHABLE_KEY=<existing pk_test key>
#   VITE_CLERK_ADMIN_IDS=<development Clerk user IDs>
#
# Manual production build: create .env.production.local
#   VITE_CLERK_PUBLISHABLE_KEY=<pk_live key>
#   VITE_CLERK_ADMIN_IDS=<production Clerk user IDs>
#
# Cloudflare Builds must define the same two production values in its build
# environment. The Vite and deployment guards reject crossed or missing keys.

# Server-side Clerk values for local Worker authentication belong in
# .env.local and must point to the development Clerk instance.
CLERK_ISSUER=
CLERK_ADMIN_IDS=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Other local Worker/build credentials (never commit real values).
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
CLOUDFLARE_D1_ANALYTICS_READ_TOKEN=
