# Shared local-only variables may remain in .env.local, but the Clerk client
# publishable key must be mode-specific so development and production cannot mix.
#
# Local development: create .env.development.local
#   VITE_CLERK_PUBLISHABLE_KEY=<existing pk_test key>
#
# Manual production build: create .env.production.local
#   VITE_CLERK_PUBLISHABLE_KEY=<pk_live key>
#
# Cloudflare Builds must define the same production publishable key in its build
# environment. Administrator authority is decided only by the Worker's
# CLERK_ADMIN_IDS secret; it is never embedded in the browser bundle.

# Server-side Clerk values for local Worker authentication belong in
# .env.local and must point to the development Clerk instance.
CLERK_ISSUER=
CLERK_ADMIN_IDS=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Other local Worker/build credentials (never commit real values).
YOUTUBE_API_KEY=
GEMINI_API_KEY=
# Enable only in the local Worker environment after configuring Gemini.
OTW_PLAY_AI_REVIEW_ENABLED=false
OTW_PLAY_AI_REVIEW_MODEL=gemini-3.8-flash
OTW_PLAY_AI_REVIEW_DAILY_LIMIT=100
X_BEARER_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
