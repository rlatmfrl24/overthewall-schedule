{
  "name": "overthewall-schedule",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-site.mjs dev --site=otw",
    "dev:restart": "node scripts/dev-restart.mjs --site=otw",
    "dev:stop": "node scripts/dev-restart.mjs --site=otw --kill-only",
    "build": "node scripts/build-site.mjs --site=otw",
    "lint": "eslint .",
    "architecture:check": "node scripts/architecture-check.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --config vitest.all.config.ts && node --test scripts/sync-agent-to-cursor.test.mjs",
    "test:unit": "vitest run",
    "test:worker-integration": "vitest run --config vitest.all.config.ts --project=worker-integration --project=worker-schema --project=worker-workflow",
    "test:coverage": "vitest run --coverage --config vitest.all.config.ts",
    "preflight": "node scripts/preflight.mjs",
    "preflight:release": "pnpm run preflight",
    "preflight:migration": "pnpm run preflight",
    "preview": "pnpm run build && node scripts/run-site.mjs preview --site=otw",
    "deploy": "pnpm run build && node scripts/deploy-workers.mjs --site=otw",
    "deploy:dry-run": "pnpm run build && node scripts/deploy-workers.mjs --site=otw --dry-run",
    "deploy:check:d1-metrics": "node scripts/d1-metrics-deploy-guard.mjs",
    "queues:provision": "node scripts/provision-ops-queues.mjs",
    "images:profile-backgrounds": "node scripts/optimize-profile-backgrounds.mjs",
    "r2:upload-profile-backgrounds": "node scripts/upload-profile-backgrounds-to-r2.mjs",
    "cf-typegen": "wrangler types --strict-vars=false",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:generate:custom": "drizzle-kit generate --custom",
    "drizzle:migrate:remote": "wrangler d1 migrations apply otw-db --remote",
    "drizzle:migrate:local": "node scripts/d1-migrate-local.mjs --site=otw",
    "d1:doctor": "node scripts/d1-doctor.mjs --site=otw",
    "d1:reset:local": "node scripts/d1-reset-local.mjs --site=otw",
    "d1:seed:local": "node scripts/d1-seed-local.mjs --site=otw",
    "sync:agent-cursor": "node scripts/sync-agent-to-cursor.mjs",
    "sync:agent-cursor:check": "node scripts/sync-agent-to-cursor.mjs --check",
    "dev:luvdia": "node scripts/run-site.mjs dev --site=luvdia",
    "dev:restart:luvdia": "node scripts/dev-restart.mjs --site=luvdia",
    "dev:stop:luvdia": "node scripts/dev-restart.mjs --site=luvdia --kill-only",
    "build:luvdia": "node scripts/build-site.mjs --site=luvdia",
    "preview:luvdia": "pnpm run build:luvdia && node scripts/run-site.mjs preview --site=luvdia",
    "deploy:luvdia": "pnpm run build:luvdia && node scripts/deploy-workers.mjs --site=luvdia",
    "d1:doctor:luvdia": "node scripts/d1-doctor.mjs --site=luvdia",
    "d1:reset:local:luvdia": "node scripts/d1-reset-local.mjs --site=luvdia",
    "d1:seed:local:luvdia": "node scripts/d1-seed-local.mjs --site=luvdia",
    "drizzle:migrate:local:luvdia": "node scripts/d1-migrate-local.mjs --site=luvdia"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@clerk/clerk-react": "^5.61.8",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-router": "^1.170.33",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.554.0",
    "motion": "^12.23.25",
    "react": "^19.2.6",
    "react-day-picker": "^9.11.2",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.70.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^9.39.5",
    "@tanstack/router-plugin": "^1.168.36",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.11.21",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "4.129.1"
  }
}
